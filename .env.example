# ---------------------------------------------------------------------------
# LLM provider: nvidia | gemini | aicredits | anthropic | ollama  (all OpenAI-compatible)
# Copy this file to .env and fill in the key for the provider you choose.
# Without a key the app still runs using rule/template fallbacks.
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic

# NVIDIA build.nvidia.com (free, ~40 requests/min) - key starts with nvapi-
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash

# Google Gemini API free tier (aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# AICredits (paid, OpenAI-compatible)
AICREDITS_API_KEY=
AICREDITS_BASE_URL=https://aicredits.in/v1
AICREDITS_MODEL=gpt-5-nano

# Anthropic Claude (paid, OpenAI-compatible endpoint) - key starts with sk-ant-
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Ollama (local, free): run `ollama pull llama3.2:3b` first
OLLAMA_MODEL=llama3.2:3b

# Optional overrides
# LLM_MODEL=            # model for the agents (overrides the provider default)
# JUDGE_MODEL=          # model for LLM-as-Judge / DeepEval / RAGAS
# LLM_MAX_RPM=35        # client-side throttle, requests per minute (0 = off)
LLM_ENABLED=true

# 0 = index all rows; otherwise index a stratified sample of N rows (faster build)
INDEX_SAMPLE_SIZE=0
# Frontend -> backend URL
API_URL=http://127.0.0.1:8000
